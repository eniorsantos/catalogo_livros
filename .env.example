PORT=3000
# local = só SQLite | cloud = só PostgreSQL | hybrid = grava nos dois, lê do local
DB_MODE=local
SQLITE_FILE=./data/books.db
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# Obrigatório em produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-isto
# false = desativa novos cadastros (use depois de criar sua conta)
ALLOW_REGISTER=true
